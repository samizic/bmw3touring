---
// Muted looping film below the hero. Loads and plays only while on screen, and is skipped
// entirely for reduced-motion and data-saver visitors (they see the poster frame).
import { existsSync } from 'node:fs';
import { getImage } from 'astro:assets';
import posterSrc from '../assets/home/render-studio-lci.png';

const hasVideo = existsSync('public/video/hero-1080.mp4');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const poster = await getImage({ src: posterSrc, width: 1280, format: 'webp' });
---

{hasVideo && (
  <section id="film" class="film container" aria-labelledby="film-title">
    <header data-reveal>
      <p class="eyebrow">In motion</p>
      <h2 id="film-title">The 3 Touring</h2>
    </header>
    <div class="frame" data-reveal>
      <video
        muted
        loop
        playsinline
        preload="none"
        poster={poster.src}
        aria-label="BMW film of the 3 Series Touring: exterior details and turntable views"
        data-film
        data-sources={JSON.stringify({
          '720': [`${base}/video/hero-720.webm`, `${base}/video/hero-720.mp4`],
          '1080': [`${base}/video/hero-1080.webm`, `${base}/video/hero-1080.mp4`],
        })}
      ></video>
      <button class="toggle" type="button" data-film-toggle aria-pressed="false" hidden>
        <span class="sr-only">Pause film</span>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path class="i-pause" d="M7 5h3v14H7zM14 5h3v14h-3z" /><path class="i-play" d="M8 5l11 7-11 7z" /></svg>
      </button>
    </div>
    <p class="credit">Film: BMW AG.</p>
  </section>
)}

<style>
  .film { padding-top: clamp(80px, 12vw, 160px); scroll-margin-top: var(--header-h); }
  header { margin-bottom: 24px; }
  h2 { font-size: clamp(2.5rem, 6vw, 5rem); margin-top: 10px; }
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #fff;
  }
  .frame::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 96px;
    height: 6px;
    background: linear-gradient(90deg,
      var(--m-light-blue) 0 33%, var(--m-dark-blue) 33% 66%, var(--m-red) 66%);
  }
  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .toggle {
    position: absolute;
    right: 14px;
    bottom: 18px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgb(255 255 255 / 0.4);
    background: rgb(11 11 13 / 0.55);
    color: #fff;
    cursor: pointer;
  }
  .toggle svg { fill: currentColor; }
  .toggle .i-play { display: none; }
  .toggle[aria-pressed='true'] .i-play { display: block; }
  .toggle[aria-pressed='true'] .i-pause { display: none; }
  .credit {
    margin: 10px 0 0;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
</style>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-film]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-film-toggle]');
  const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (video && toggle && !reduce && !conn?.saveData) {
    let loaded = false;
    let userPaused = false;
    const load = () => {
      const res = video.clientWidth * window.devicePixelRatio > 1400 ? '1080' : '720';
      const sources: Record<string, string[]> = JSON.parse(video.dataset.sources!);
      for (const src of sources[res]) {
        const s = document.createElement('source');
        s.src = src;
        s.type = src.endsWith('.webm') ? 'video/webm' : 'video/mp4';
        video.append(s);
      }
      video.load();
      loaded = true;
      toggle.hidden = false;
    };
    new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          if (!loaded) load();
          if (!userPaused) video.play().catch(() => {});
        } else {
          video.pause();
        }
      },
      { threshold: 0.35 },
    ).observe(video);
    toggle.addEventListener('click', () => {
      userPaused = !video.paused;
      if (userPaused) video.pause();
      else video.play().catch(() => {});
      toggle.setAttribute('aria-pressed', String(userPaused));
      toggle.querySelector('.sr-only')!.textContent = userPaused ? 'Play film' : 'Pause film';
    });
  }
</script>

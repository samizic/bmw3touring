---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  eyebrow: string;
  title: string;
  reverse?: boolean;
  /** CSS object-position for the crop */
  focus?: string;
  /** Show the whole image on a light surface (for studio renders on white) */
  studio?: boolean;
}

const { image, alt, eyebrow, title, reverse = false, focus = '50% 50%', studio = false } = Astro.props;
---

<article class:list={['panel', { reverse }]}>
  <div class:list={['frame', { studio }]} data-reveal>
    <Picture
      src={image}
      alt={alt}
      widths={[480, 800, 1200, 1600]}
      sizes="(max-width: 900px) 100vw, 60vw"
      formats={['avif', 'webp']}
      loading="lazy"
      decoding="async"
      style={`object-position:${focus}`}
    />
  </div>
  <div class="copy" data-reveal>
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    <div class="body"><slot /></div>
  </div>
</article>

<style>
  .panel {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    align-items: center;
    gap: clamp(32px, 6vw, 96px);
  }
  .panel.reverse { grid-template-columns: 1fr 1.5fr; }
  .panel.reverse .frame { order: 2; }

  .frame {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--bg-raised);
  }
  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.4s var(--ease);
  }
  .frame:hover :global(img) { transform: scale(1.04); }
  .frame.studio {
    background: radial-gradient(ellipse at 50% 60%, #ffffff 0%, #e6e6e9 100%);
  }
  .frame.studio :global(img) {
    object-fit: contain;
    padding: 6%;
  }
  .frame::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 96px;
    height: 6px;
    background: linear-gradient(90deg,
      var(--m-light-blue) 0 33%, var(--m-dark-blue) 33% 66%, var(--m-red) 66%);
  }
  .reverse .frame::after { left: auto; right: 0; }

  h2 {
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    margin-block: 12px 24px;
  }
  .body {
    color: var(--text-muted);
    max-width: 44ch;
  }
  .body :global(p) { margin: 0 0 1em; }

  .copy { transition-delay: 0.12s; }

  @media (max-width: 900px) {
    .panel,
    .panel.reverse { grid-template-columns: 1fr; }
    .panel.reverse .frame { order: 0; }
  }
</style>

---
import { Picture } from 'astro:assets';
// Full-resolution (4080 px) source, so the hero stays sharp on large retina screens
import poster from '../assets/gallery/pxl_20240217_124148987_wheels.jpg';
---

<section class="hero" aria-label="BMW 330d Touring">
  <div class="media">
    <Picture
      src={poster}
      alt="The Alpine White 330d Touring parked on a coastal road above a calm Adriatic sea"
      widths={[640, 1024, 1440, 2000, 2880, 3840]}
      sizes="130vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
      class="poster"
    />
    <div class="shade" aria-hidden="true"></div>
  </div>

  <div class="container content">
    <p class="eyebrow">2024 · G21 LCI · M Sport</p>
    <h1>
      <span class="line">The 3</span>
      <span class="line outline">Touring</span>
    </h1>
    <div class="meta">
      <span class="m-stripe" aria-hidden="true"><span></span><span></span><span></span></span>
      <p>330d · Alpine White · Rear-wheel drive</p>
    </div>
  </div>

  <a class="scroll-cue" href="#stats" aria-label="Scroll to content">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 560px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    isolation: isolate;
  }
  .media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .media :global(.poster) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* The photo is widened past the right edge (anchored left) so the car sits clear of the title */
  .media :global(.poster) {
    right: auto;
    width: var(--hero-w, 120%);
    max-width: none;
    object-position: 50% 62%;
    transform-origin: 100% 60%;
    animation: hero-zoom 14s var(--ease) both;
  }
  .shade {
    position: absolute;
    inset: 0;
    background:
      /* top: keeps the menu readable */
      linear-gradient(180deg, rgb(11 11 13 / 0.55) 0%, rgb(11 11 13 / 0) 28%),
      /* bottom: short fade into the page, full width */
      linear-gradient(0deg, var(--bg) 0%, rgb(11 11 13 / 0.35) 12%, rgb(11 11 13 / 0) 26%),
      /* left: darkens behind the title only, clear of the car */
      radial-gradient(ellipse 60% 75% at 0% 78%, rgb(11 11 13 / 0.78) 0%, rgb(11 11 13 / 0.45) 50%, rgb(11 11 13 / 0) 100%);
  }

  .content {
    padding-bottom: clamp(72px, 12vh, 140px);
  }
  h1 {
    font-size: clamp(4.5rem, 11.5vw, 13rem);
    margin-block: 12px 28px;
  }
  .line {
    display: block;
    animation: rise 1.1s var(--ease) both;
  }
  .line:nth-child(2) { animation-delay: 0.12s; }
  .outline {
    color: transparent;
    -webkit-text-stroke: 2px var(--alpine-white);
  }
  .eyebrow { animation: rise 1s var(--ease) 0.05s both; color: var(--text); }
  .meta {
    display: flex;
    align-items: center;
    gap: 18px;
    animation: rise 1s var(--ease) 0.3s both;
  }
  .meta p {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1rem, 2vw, 1.25rem);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 28px;
    width: 26px;
    height: 42px;
    margin-left: -13px;
    border: 2px solid rgb(255 255 255 / 0.5);
    border-radius: 14px;
  }
  .scroll-cue span {
    position: absolute;
    left: 50%;
    top: 8px;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    border-radius: 2px;
    background: #fff;
    animation: cue 1.8s ease-in-out infinite;
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(40px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes hero-zoom {
    from { transform: scale(1.08); }
    to { transform: scale(1); }
  }
  @keyframes cue {
    0% { opacity: 0; transform: translateY(0); }
    40% { opacity: 1; }
    100% { opacity: 0; transform: translateY(14px); }
  }

  /* Narrow screens: the photo is cropped at the sides instead, so aim the crop at the car */
  @media (max-aspect-ratio: 3/2) {
    .hero { --hero-w: 100%; }
    .media :global(.poster) { object-position: 78% 62%; }
  }
  @media (max-width: 760px) {
    .outline { -webkit-text-stroke-width: 1.5px; }
    .scroll-cue { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .line, .eyebrow, .meta, .media :global(.poster), .scroll-cue span { animation: none; }
  }
</style>


---
import { url } from '../lib/url';

const items = [
  {
    href: 'specs',
    index: '01',
    title: 'Technical specs',
    text: 'Engine, drivetrain, performance, dimensions and capacities.',
    ready: true,
  },
  {
    href: 'gallery',
    index: '02',
    title: 'Gallery',
    text: 'Coast roads, mountain fog, winter trips and details.',
    ready: true,
  },
  {
    href: 'diy-service',
    index: '03',
    title: 'DIY & Service',
    text: 'Every service, upgrade and DIY job, with photos.',
    ready: true,
  },
];
---

<section class="teasers" aria-labelledby="explore-title">
  <div class="container">
    <header class="head" data-reveal>
      <p class="eyebrow">Explore</p>
      <h2 id="explore-title">More of the car</h2>
    </header>

    <ul class="cards">
      {items.map((it, i) => {
        const Tag = it.ready ? 'a' : 'div';
        return (
          <li data-reveal style={`transition-delay:${i * 90}ms`}>
            <Tag class:list={['card', { soon: !it.ready }]} href={it.ready ? url(it.href) : undefined}>
              <span class="index">{it.index}</span>
              <h3>{it.title}</h3>
              <p>{it.text}</p>
              <span class="cta">
                {it.ready ? 'Discover' : 'Coming soon'}
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" />
                </svg>
              </span>
            </Tag>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .teasers { padding-block: clamp(80px, 12vw, 160px); }
  .head { margin-bottom: 48px; }
  h2 {
    font-size: clamp(2.5rem, 6vw, 5rem);
    margin-top: 12px;
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .cards li { display: flex; }
  .card {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(28px, 3vw, 44px);
    background: var(--bg-raised);
    text-decoration: none;
    overflow: hidden;
    transition: background-color 0.4s var(--ease);
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: linear-gradient(90deg,
      var(--m-light-blue) 0 33%, var(--m-dark-blue) 33% 66%, var(--m-red) 66%);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease);
  }
  a.card:hover { background: var(--bg-elevated); }
  a.card:hover::before { transform: scaleX(1); }

  .index {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    color: var(--m-light-blue);
    letter-spacing: 0.1em;
  }
  h3 { font-size: clamp(1.75rem, 2.6vw, 2.25rem); }
  .card p { margin: 0; color: var(--text-muted); flex: 1; }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: 0.85rem;
    margin-top: 12px;
  }
  .cta svg { transition: transform 0.35s var(--ease); }
  a.card:hover .cta svg { transform: translateX(6px); }
  .soon .cta { color: var(--text-muted); }
  .soon .cta svg { display: none; }

  @media (max-width: 900px) {
    .cards { grid-template-columns: 1fr; }
  }
</style>

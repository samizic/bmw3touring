---
// Responsive photo grid with a full-screen lightbox.
// Without JavaScript each thumbnail still links to the full-size image.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photos: { src: ImageMetadata; caption: string }[];
  /** First photo large; pairs shown side by side */
  feature?: boolean;
}

const { photos, feature = false } = Astro.props;

const items = await Promise.all(
  photos.map(async (p) => {
    const full = await getImage({ src: p.src, width: Math.min(p.src.width, 2400), format: 'webp' });
    return { ...p, full: full.src, portrait: p.src.height > p.src.width };
  }),
);
---

<div class:list={['gallery', { feature, pair: feature && photos.length === 2 }]} data-gallery>
  {items.map((p, i) => (
    <a
      class:list={['tile', { portrait: p.portrait }]}
      href={p.full}
      data-index={i}
      data-caption={p.caption}
      aria-label={`Open photo ${i + 1}: ${p.caption}`}
    >
      <Image
        src={p.src}
        alt={p.caption}
        widths={feature ? [480, 800, 1200, 1600] : [360, 640, 960]}
        sizes={feature
          ? (i === 0 || photos.length === 2 ? '(max-width: 640px) 100vw, 66vw' : '(max-width: 640px) 50vw, 33vw')
          : '(max-width: 640px) 50vw, (max-width: 1100px) 33vw, 25vw'}
        format="webp"
        loading="lazy"
        decoding="async"
      />
    </a>
  ))}
</div>

<dialog class="lightbox" data-lightbox aria-label="Photo viewer">
  <figure>
    <img data-lb-img alt="" />
    <figcaption>
      <span data-lb-caption></span>
      <span class="count" data-lb-count></span>
    </figcaption>
  </figure>
  <button class="lb-btn close" data-lb-close aria-label="Close">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
  <button class="lb-btn prev" data-lb-prev aria-label="Previous photo">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
  </button>
  <button class="lb-btn next" data-lb-next aria-label="Next photo">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
  </button>
</dialog>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: clamp(140px, 16vw, 240px);
    grid-auto-flow: dense;
    gap: 6px;
  }
  .tile {
    position: relative;
    overflow: hidden;
    background: var(--bg-raised);
  }
  .tile.portrait { grid-row: span 2; }
  /* feature layout: lead photo spans 2x2; a pair fills one wide row */
  .feature { grid-template-columns: repeat(3, 1fr); grid-auto-rows: clamp(160px, 19vw, 300px); }
  .feature .tile:first-child { grid-column: span 2; grid-row: span 2; }
  .feature.pair { grid-template-columns: repeat(2, 1fr); grid-auto-rows: clamp(200px, 28vw, 420px); }
  .feature.pair .tile:first-child, .feature.pair .tile.portrait { grid-column: auto; grid-row: auto; }
  .feature .tile:only-child { grid-column: 1 / -1; grid-row: span 2; }
  .tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease), opacity 0.4s;
  }
  .tile::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 3px;
    background: linear-gradient(90deg,
      var(--m-light-blue) 0 33%, var(--m-dark-blue) 33% 66%, var(--m-red) 66%);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease);
  }
  .tile:hover :global(img) { transform: scale(1.05); }
  .tile:hover::after,
  .tile:focus-visible::after { transform: scaleX(1); }

  @media (max-width: 1100px) { .gallery { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 640px) {
    .gallery { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 42vw; gap: 4px; }
  }

  /* Lightbox */
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(5 5 7 / 0.96);
    color: var(--text);
  }
  .lightbox::backdrop { background: rgb(0 0 0 / 0.6); }
  .lightbox[open] { display: grid; place-items: center; animation: fade 0.25s ease; }
  figure {
    margin: 0;
    display: grid;
    gap: 14px;
    justify-items: center;
    padding: 64px clamp(16px, 7vw, 96px) 24px;
    max-width: 100%;
  }
  figure img {
    max-width: 100%;
    max-height: calc(100dvh - 150px);
    object-fit: contain;
    touch-action: pan-y;
    user-select: none;
  }
  figcaption {
    display: flex;
    gap: 18px;
    align-items: baseline;
    max-width: 70ch;
    text-align: center;
    font-size: 0.95rem;
    color: var(--text-muted);
  }
  .count {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--m-light-blue);
    white-space: nowrap;
  }
  .lb-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--line);
    background: rgb(20 20 24 / 0.7);
    color: var(--text);
    cursor: pointer;
    transition: background-color 0.2s, border-color 0.2s;
  }
  .lb-btn:hover { background: var(--bg-elevated); border-color: var(--m-light-blue); }
  .lb-btn svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2; }
  .close { top: 12px; right: 12px; }
  .prev { left: 12px; top: 50%; translate: 0 -50%; }
  .next { right: 12px; top: 50%; translate: 0 -50%; }
  @media (max-width: 640px) {
    .prev, .next { top: auto; bottom: 12px; translate: none; }
    figure { padding-inline: 8px; padding-bottom: 84px; }
    figcaption { padding-inline: 56px; flex-direction: column; align-items: center; gap: 4px; }
  }
  @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const dialog = gallery.nextElementSibling as HTMLDialogElement;
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    const count = dialog.querySelector<HTMLElement>('[data-lb-count]')!;
    const tiles = [...gallery.querySelectorAll<HTMLAnchorElement>('a[data-index]')];
    let index = 0;

    const show = (i: number) => {
      index = (i + tiles.length) % tiles.length;
      const t = tiles[index];
      img.src = t.href;
      img.alt = t.dataset.caption ?? '';
      caption.textContent = t.dataset.caption ?? '';
      count.textContent = `${index + 1} / ${tiles.length}`;
      // Preload neighbours for instant paging
      [index - 1, index + 1].forEach((n) => {
        const nb = tiles[(n + tiles.length) % tiles.length];
        new Image().src = nb.href;
      });
    };

    tiles.forEach((t, i) =>
      t.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        dialog.showModal();
      }),
    );

    dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-lb-next]')!.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || e.target === dialog.querySelector('figure')) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    dialog.addEventListener('close', () => tiles[index]?.focus());

    // Swipe on touch screens
    let startX = 0;
    img.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    img.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  });
</script>

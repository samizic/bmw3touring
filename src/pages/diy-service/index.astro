---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { getJobs, getJobPhotos, formatDate, formatKm } from '../../lib/maintenance';
import { url } from '../../lib/url';
import heroImage from '../../assets/pages/diy-service-hero.jpg';

const jobs = await getJobs();

// Group by year, newest first
const years = [...new Set(jobs.map((j) => j.data.date.getFullYear()))];
---

<Base
  title="DIY & Service"
  description="Service history, detailing, upgrades and DIY jobs on my BMW 330d Touring, with photos."
>
  <PageHero
    eyebrow="Service log"
    title="DIY & Service"
    image={heroImage}
    alt="The 330d Touring in a detailing studio, wheels covered"
    focus="50% 40%"
  >
    <p class="lede">
      {jobs.length} {jobs.length === 1 ? 'job' : 'jobs'} logged. Every service, upgrade and DIY job, with photos.
    </p>
  </PageHero>

  <div class="container log">
    {years.map((year) => (
      <section class="year" aria-labelledby={`y${year}`}>
        <h2 id={`y${year}`} class="year-label">{year}</h2>
        <ol class="jobs">
          {jobs
            .filter((j) => j.data.date.getFullYear() === year)
            .map((job) => {
              const d = job.data;
              const photoCount = getJobPhotos(job).length;
              return (
                <li data-reveal>
                  <a class="job" href={url(`diy-service/${job.id}`)}>
                    <div class="thumb">
                      <Image
                        src={d.cover}
                        alt={d.coverAlt}
                        widths={[400, 700, 1000]}
                        sizes="(max-width: 760px) 100vw, 40vw"
                        format="webp"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <div class="info">
                      <p class="meta">
                        <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
                        <span class="chip">{d.category}</span>
                      </p>
                      <h3>{d.title}</h3>
                      <p class="summary">{d.summary}</p>
                      <p class="facts">
                        {d.mileage !== undefined && <span>{formatKm(d.mileage)}</span>}
                        {d.performedBy && <span>{d.performedBy}</span>}
                        {photoCount > 0 && <span>{photoCount} photos</span>}
                      </p>
                      <span class="cta">
                        Read more
                        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                          <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" />
                        </svg>
                      </span>
                    </div>
                  </a>
                </li>
              );
            })}
        </ol>
      </section>
    ))}

    {jobs.length === 0 && <p class="empty">No jobs logged yet.</p>}
  </div>
</Base>

<style>
  .lede {
    margin: 20px 0 0;
    max-width: 52ch;
    color: var(--text);
  }
  .log {
    padding-block: clamp(56px, 8vw, 112px);
    display: grid;
    gap: clamp(56px, 8vw, 96px);
  }
  .year {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: clamp(24px, 4vw, 64px);
    align-items: start;
  }
  .year-label {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    font-size: clamp(3rem, 6vw, 5rem);
    color: transparent;
    -webkit-text-stroke: 1.5px var(--text-muted);
  }
  .jobs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .job {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    background: var(--bg-raised);
    text-decoration: none;
    overflow: hidden;
    transition: background-color 0.4s var(--ease);
  }
  .job::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    z-index: 1;
    background: linear-gradient(90deg,
      var(--m-light-blue) 0 33%, var(--m-dark-blue) 33% 66%, var(--m-red) 66%);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease);
  }
  .job:hover { background: var(--bg-elevated); }
  .job:hover::before { transform: scaleX(1); }
  .thumb {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease);
  }
  .job:hover .thumb :global(img) { transform: scale(1.05); }
  .info {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: clamp(24px, 3vw, 40px);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .chip {
    padding: 3px 10px;
    border: 1px solid var(--m-light-blue);
    color: var(--m-light-blue);
    font-size: 0.75rem;
  }
  h3 { font-size: clamp(2rem, 3.4vw, 3rem); }
  .summary { margin: 0; color: var(--text-muted); }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin: 0;
    font-size: 0.9rem;
    color: var(--text);
  }
  .facts span + span::before {
    content: '·';
    margin-right: 20px;
    color: var(--text-muted);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
    padding-top: 8px;
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: 0.85rem;
  }
  .cta svg { transition: transform 0.35s var(--ease); }
  .job:hover .cta svg { transform: translateX(6px); }
  .empty { color: var(--text-muted); }

  @media (max-width: 900px) {
    .year { grid-template-columns: 1fr; gap: 16px; }
    .year-label { position: static; }
  }
  @media (max-width: 760px) {
    .job { grid-template-columns: 1fr; }
  }
</style>

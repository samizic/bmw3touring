---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import LightboxGallery from '../../components/LightboxGallery.astro';
import { getJobs, getJobPhotos, formatDate, formatKm, type Job } from '../../lib/maintenance';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const jobs = await getJobs();
  // jobs are newest first: "newer" is the previous entry, "older" the next
  return jobs.map((job, i) => ({
    params: { slug: job.id },
    props: { job, newer: jobs[i - 1], older: jobs[i + 1] },
  }));
}

interface Props {
  job: Job;
  newer?: Job;
  older?: Job;
}

const { job, newer, older } = Astro.props;
const d = job.data;
const { Content } = await render(job);
const photos = getJobPhotos(job);

const facts = [
  { label: 'Date', value: formatDate(d.date) },
  { label: 'Category', value: d.category },
  d.mileage !== undefined && { label: 'Mileage', value: formatKm(d.mileage) },
  d.performedBy && { label: 'Done by', value: d.performedBy },
  d.cost && { label: 'Cost', value: d.cost },
].filter(Boolean) as { label: string; value: string }[];
---

<Base title={d.title} description={d.summary}>
  <PageHero eyebrow={`DIY & Service · ${d.category}`} title={d.title} image={d.cover} alt={d.coverAlt}>
    <p class="lede">{d.summary}</p>
  </PageHero>

  <section class="facts" aria-label="Job details">
    <dl class="container">
      {facts.map((f) => (
        <div>
          <dt>{f.label}</dt>
          <dd>{f.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <div class="container body">
    <article class="prose">
      <Content />
    </article>

    <aside class="side">
      {d.products.length > 0 && (
        <section>
          <h2>Products used</h2>
          <ul>{d.products.map((p) => <li>{p}</li>)}</ul>
        </section>
      )}
      {d.downloads.length > 0 && (
        <section>
          <h2>Downloads</h2>
          <ul>
            {d.downloads.map((f) => (
              <li>
                <a class="file" href={url(`downloads/${f.file}`)} download>
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                    <path d="M12 4v11M7 10l5 5 5-5M5 20h14" fill="none" stroke="currentColor" stroke-width="2" />
                  </svg>
                  {f.label}
                </a>
                {f.note && <small>{f.note}</small>}
              </li>
            ))}
          </ul>
        </section>
      )}
      {d.links.length > 0 && (
        <section>
          <h2>References</h2>
          <ul>
            {d.links.map((l) => (
              <li><a class="file" href={l.url} target="_blank" rel="noopener">{l.label} ↗</a></li>
            ))}
          </ul>
        </section>
      )}
      <a class="back" href={url('diy-service')}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M19 12H5M11 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" />
        </svg>
        All jobs
      </a>
    </aside>
  </div>

  {photos.length > 0 && (
    <section class="container photos" aria-labelledby="photos-title">
      <header>
        <p class="eyebrow">Gallery</p>
        <h2 id="photos-title">Photos <span>{photos.length}</span></h2>
      </header>
      <LightboxGallery photos={photos} />
    </section>
  )}

  {(newer || older) && (
    <nav class="container pager" aria-label="More jobs">
      {older ? (
        <a href={url(`diy-service/${older.id}`)} class="older">
          <span class="dir">Older</span>
          <span class="t">{older.data.title}</span>
        </a>
      ) : <span />}
      {newer && (
        <a href={url(`diy-service/${newer.id}`)} class="newer">
          <span class="dir">Newer</span>
          <span class="t">{newer.data.title}</span>
        </a>
      )}
    </nav>
  )}
</Base>

<style>
  .lede {
    margin: 20px 0 0;
    max-width: 56ch;
    color: var(--text);
  }

  .facts {
    border-block: 1px solid var(--line);
    background: var(--bg-raised);
  }
  .facts dl {
    display: flex;
    flex-wrap: wrap;
    margin-block: 0;
  }
  .facts div {
    padding: 22px clamp(16px, 3vw, 40px);
    border-left: 1px solid var(--line);
  }
  .facts div:first-child { border-left: 0; padding-left: 0; }
  dt {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  dd {
    margin: 4px 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: clamp(32px, 6vw, 96px);
    padding-block: clamp(56px, 8vw, 104px);
  }

  /* Markdown body */
  .prose { max-width: 72ch; }
  .prose :global(h2) {
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    margin: 2em 0 0.6em;
  }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h2)::before {
    content: '';
    display: block;
    width: 72px;
    height: 4px;
    margin-bottom: 18px;
    background: linear-gradient(90deg,
      var(--m-light-blue) 0 33%, var(--m-dark-blue) 33% 66%, var(--m-red) 66%);
  }
  .prose :global(p),
  .prose :global(li) { color: #c9c9d1; }
  .prose :global(strong) { color: var(--text); font-weight: 600; }
  .prose :global(ul) { padding-left: 1.2em; }
  .prose :global(li) { margin-block: 0.35em; }
  .prose :global(li::marker) { color: var(--m-light-blue); }
  .prose :global(a) { color: var(--m-light-blue); }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-block: 1.2em;
    font-size: 0.95rem;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 10px 12px;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }
  .prose :global(th) {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .prose :global(td:first-child) { color: var(--text-muted); }
  .prose :global(img) {
    width: 100%;
    height: auto;
    margin-block: 1.5em 0.5em;
    background: var(--bg-raised);
  }

  .side {
    display: grid;
    gap: 32px;
    align-content: start;
    position: sticky;
    top: calc(var(--header-h) + 32px);
    align-self: start;
  }
  .side section {
    padding: 28px;
    background: var(--bg-raised);
    border-top: 4px solid var(--m-light-blue);
  }
  .side h2 {
    font-size: 1.5rem;
    margin-bottom: 14px;
  }
  .side ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .side li {
    padding-block: 10px;
    border-top: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .side .file {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text);
    font-weight: 400;
    text-decoration: none;
    border-bottom: 1px solid var(--m-light-blue);
  }
  .side .file:hover { color: var(--m-light-blue); }
  .side small {
    display: block;
    margin-top: 4px;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--text-muted);
    transition: color 0.2s;
  }
  .back:hover { color: var(--text); }

  .photos { padding-bottom: clamp(56px, 8vw, 104px); }
  .photos header { margin-bottom: 28px; }
  .photos h2 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-top: 10px;
  }
  .photos h2 span {
    font-size: 0.45em;
    vertical-align: super;
    color: var(--m-light-blue);
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: clamp(56px, 8vw, 104px);
  }
  .pager a {
    display: grid;
    gap: 4px;
    max-width: 48%;
    padding: 20px 24px;
    background: var(--bg-raised);
    text-decoration: none;
    transition: background-color 0.3s;
  }
  .pager a:hover { background: var(--bg-elevated); }
  .pager .newer { text-align: right; margin-left: auto; }
  .dir {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--m-light-blue);
  }
  .t {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    text-transform: uppercase;
  }

  @media (max-width: 960px) {
    .body { grid-template-columns: 1fr; }
    .side { position: static; }
  }
  @media (max-width: 560px) {
    .facts div { flex: 1 1 50%; border-left: 0; padding-left: 0; padding-block: 14px; }
    .facts div:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
</style>

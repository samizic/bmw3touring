---
// Old addresses of individual jobs, from before the section was renamed to DIY & Service
import Redirect from '../../components/Redirect.astro';
import { getJobs } from '../../lib/maintenance';

export async function getStaticPaths() {
  return (await getJobs()).map((job) => ({ params: { slug: job.id } }));
}
---

<Redirect to={`diy-service/${Astro.params.slug}`} />

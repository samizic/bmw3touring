---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'BMW 330d Touring · G21',
  description = 'My 2024 BMW 330d Touring (G21 LCI) in Alpine White with M Sport package — specs, gallery and DIY & service log.',
} = Astro.props;
const fullTitle = title.includes('330d') ? title : `${title} · BMW 330d Touring`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b0d" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <title>{fullTitle}</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll reveal for anything marked [data-reveal]
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      els.forEach((el) => io.observe(el));
    </script>
  </body>
</html>
